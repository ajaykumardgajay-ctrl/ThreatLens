# TRACEPOINT Backend Configuration
TRACEPOINT_DB_PATH=./data/tracepoint.db
TRACEPOINT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Detection & Correlation Defaults
TRACEPOINT_BRUTE_FORCE_THRESHOLD=5
TRACEPOINT_BRUTE_FORCE_WINDOW_SECONDS=120
TRACEPOINT_IMPOSSIBLE_TRAVEL_SPEED_KMH=800
TRACEPOINT_CORRELATION_WINDOW_MINUTES=45
TRACEPOINT_OUTBOUND_SPIKE_MULTIPLIER=10.0

# Optional LLM Integration (Leave blank for deterministic offline investigation assistant)
TRACEPOINT_LLM_API_KEY=
TRACEPOINT_LLM_MODEL=gpt-4o-mini
TRACEPOINT_LLM_BASE_URL=https://api.openai.com/v1
